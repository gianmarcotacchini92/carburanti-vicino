# Optional for local development: copy this file to .env.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
DATA_REFRESH_HOURS=6
GEOCODER_URL=https://photon.komoot.io/api/

# Production requires your actual HTTPS origin and a real operator contact.
# APP_ORIGIN=https://carburanti.example.it
# VAPID_SUBJECT=mailto:gestore@example.it
# TRUST_PROXY=1

# Docker Compose also requires DOMAIN and VAPID_SUBJECT (without comments).
# DOMAIN=carburanti.example.it

# GitHub Pages + Cloudflare (build-time settings, no secrets):
# VITE_BASE_PATH=/carburanti-vicino/
# VITE_API_URL=https://carburanti-vicino-api.YOUR-SUBDOMAIN.workers.dev
